# Copier ce fichier en ".env" et y mettre les vraies valeurs.
# Le fichier .env est ignore par git : aucune cle ne doit etre committee.

# --- Source de telemetrie : auto | krpc | sim ---
KSP_MC_SOURCE=auto
KRPC_ADDRESS=127.0.0.1
KRPC_RPC_PORT=50000
KRPC_STREAM_PORT=50001

# --- Diffusion ---
TELEMETRY_HZ=10

# --- Serveur ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Radio (pour plus tard) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
