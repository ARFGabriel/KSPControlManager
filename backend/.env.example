# Copier ce fichier en ".env" et y mettre les vraies valeurs.
# Le fichier .env est ignore par git : aucune cle ne doit etre committee.

# --- Source de telemetrie : auto | krpc | sim ---
KSP_MC_SOURCE=auto
KRPC_ADDRESS=127.0.0.1
KRPC_RPC_PORT=50000
KRPC_STREAM_PORT=50001

# --- Diffusion ---
TELEMETRY_HZ=10

# --- Serveur ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Radio ---
# ATTENTION : ce fichier-ci est VERSIONNE. Ne jamais y mettre de vraie cle.
# Les vraies valeurs vont dans .env, qui est ignore par git.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# La liste des modeles acceptes par ta cle est sur /api/radio/models
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
